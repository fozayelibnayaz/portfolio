{
  "name": "fozayel-portfolio",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 4321",
    "build": "astro check && astro build",
    "build:fast": "astro build",
    "preview": "astro preview --host 0.0.0.0 --port 4322",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "verify": "npm run build && node scripts/check-tokens.mjs && vitest run",
    "ci": "npm run verify",
    "sync:repos": "node scripts/sync-repos.mjs"
  },
  "dependencies": {
    "astro": "^5.14.1",
    "gsap": "^3.13.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.5",
    "lightningcss": "^1.33.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
