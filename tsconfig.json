{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "src/*": [
        "src/*"
      ]
    },
    "strictNullChecks": true,
    "allowJs": true,
    "verbatimModuleSyntax": true,
    "types": [
      "node"
    ]
  }
}