---
import Base from 'src/layouts/Base.astro';
import Header from 'src/components/Header.astro';
import Hero from 'src/components/Hero.astro';
import Marquee from 'src/components/Marquee.astro';
import Capabilities from 'src/components/Capabilities.astro';
import Work from 'src/components/Work.astro';
import Stats from 'src/components/Stats.astro';
import About from 'src/components/About.astro';
import Experience from 'src/components/Experience.astro';
import Transmission from 'src/components/Transmission.astro';
import Engineering from 'src/components/Engineering.astro';
import Contact from 'src/components/Contact.astro';
import Footer from 'src/components/Footer.astro';
import ProjectDialog from 'src/components/ProjectDialog.astro';
---
<Base>
  <Header />
  <main id="main">
    <Hero />
    <Marquee />
    <Capabilities />
    <Work />
    <Stats />
    <About />
    <Experience />
    <Transmission />
    <Engineering />
    <Contact />
  </main>
  <Footer />
  <ProjectDialog />
</Base>
