---
import Base from 'src/layouts/Base.astro';
import Header from 'src/components/Header.astro';
import Spine from 'src/components/Spine.astro';
import Hero from 'src/components/Hero.astro';
import Gallery from 'src/components/Gallery.astro';
import SystemMap from 'src/components/SystemMap.astro';
import QueryLab from 'src/components/QueryLab.astro';
import Repos from 'src/components/Repos.astro';
import About from 'src/components/About.astro';
import Experience from 'src/components/Experience.astro';
import Contact from 'src/components/Contact.astro';
import Footer from 'src/components/Footer.astro';
import ProjectDialog from 'src/components/ProjectDialog.astro';
import Ask from 'src/components/Ask.astro';
---
<Base>
  <a class="skip-link" href="#main">Skip to content</a>
  <Header />
  <Spine />
  <main id="main" tabindex="-1">
    <Hero />
    <Gallery />
    <SystemMap />
    <QueryLab />
    <Repos />
    <About />
    <Experience />
    <Contact />
  </main>
  <Footer />
  <ProjectDialog />
  <Ask />
</Base>
