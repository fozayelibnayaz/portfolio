---
import { nav, site } from 'src/data/content';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="shell">
    <div class="footer__top">
      <div>
        <a class="footer__brand" href="#top">
          <span aria-hidden="true">F</span>
          {site.name}
        </a>
        <p class="footer__role">{site.role} · {site.location}</p>
      </div>

      <nav class="footer__nav" aria-label="Footer">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
        <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href={site.repo} target="_blank" rel="noopener noreferrer">Source</a>
      </nav>
    </div>

    <div class="footer__meta">
      <span>© {year} {site.name}</span>
      <span>Astro · no UI framework · {site.timezone}</span>
      <a class="footer__top-link" href="#top">↑ Back to top</a>
    </div>
  </div>
</footer>
