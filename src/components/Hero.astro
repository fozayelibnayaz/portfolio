---
import { site, skillGroups } from 'src/data/content';
import { asset } from 'src/lib/asset';
import snapshot from 'src/data/repos.json';
const liveNow = snapshot.repos.filter((r) => r.home).length;
const toolCount = skillGroups.reduce((n, g) => n + g.items.length, 0);
const ticker = [ ['Availability', 'Open'], ['Stack', 'React / Node'], ['Core_ID', 'Full-stack developer'] ];
---
<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero__field" aria-hidden="true"></div>
  <div class="hero__figure" aria-hidden="true">
    <img src={asset('/img/portrait-particles.png')} alt="" width="1080" height="1080" fetchpriority="high" />
    <canvas class="hero__particles" width="720" height="720" data-source={asset('/img/portrait-cutout.webp')}></canvas>
  </div>
  <div class="hero__glass" aria-hidden="true"><span></span></div>
  <div class="hero__copy">
    <h1 class="hero__title" id="hero-title"><span class="hero__title-a">Immersive</span><span class="hero__title-b">Interfaces</span></h1>
    <p class="hero__kicker"><span class="hero__rule" aria-hidden="true"></span><span>[ Full-stack · Analytics · QA ]</span><span class="hero__rule" aria-hidden="true"></span></p>
    <p class="hero__statement">I build the layers between an interface and a database — and the tests that keep them honest.</p>
    <div class="hero__mini"><span><b>{liveNow}</b> Live sites</span><span><b>{toolCount}</b> Tools</span></div>
  </div>
  <aside class="hero__panel" aria-label="Developer stats">
    <div class="hero__panel-head"><span>Developer stats</span><span class="hero__panel-fill"></span><span class="hero__panel-live"><i></i> Active</span></div>
    <div class="hero__panel-body">
      <dl class="hero__stats"><div><dt>Live sites</dt><dd>{liveNow}</dd></div><div><dt>Tools</dt><dd>{toolCount}</dd></div></dl>
      <dl class="hero__layers">
        <div><dt>Role</dt><dd>Full-stack developer</dd></div>
        <div><dt>Stack</dt><dd>React / Node</dd></div>
        <div><dt>Focus</dt><dd>Analytics / QA</dd></div>
        <div><dt>Availability</dt><dd>Open for work</dd></div>
        <div><dt>Location</dt><dd>Dhaka</dd></div>
      </dl>
    </div>
  </aside>
  <div class="hero__ticker" aria-label="Availability and stack"><div class="hero__ticker-track">{[0,1].map((i) => <div class="hero__ticker-group" aria-hidden={i === 1 ? 'true' : undefined}>{ticker.map(([label,value]) => <span class="hero__ticker-item"><span>{label}</span><b>{value}</b><i aria-hidden="true">·</i></span>)}</div>)}</div></div>
  <div class="hero__contact"><div><span>Wanna say hello?</span><a href={`mailto:${site.email}`}>{site.email}</a></div><div><span>Local time</span><b>Dhaka <span data-clock>--:--</span></b></div></div>
</section>

<script>
  import 'src/scripts/hero-particles';
</script>
