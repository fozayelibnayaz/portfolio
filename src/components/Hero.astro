---
import { asset } from 'src/lib/asset';
import snapshot from 'src/data/repos.json';
const liveNow = snapshot.repos.filter((repo) => repo.home).length;
---
<section class="hero" id="top" aria-labelledby="hero-title" style={`--hero-weave:url('${asset('/img/hero-weave-reference.png')}')`}>
  <noscript><style>
    @media(min-width:1024px){.hero{height:auto}.hero__stage{height:auto;min-height:100svh;position:relative;padding-bottom:90px}.hero__visual{height:calc(100svh - 104px);bottom:auto;clip-path:none}.hero__first{opacity:1}.hero__intro{position:relative;min-height:540px;margin-top:100svh;opacity:1}.hero__map,.hero__intro-copy{clip-path:none}.hero__title{bottom:auto;top:calc(100svh - 125px)}}
  </style></noscript>
  <div class="hero__stage" data-hero-stage>
    <div class="hero__visual" aria-hidden="true">
      <div class="hero__fabric">
        <div class="hero__weave hero__weave--top"></div>
        <div class="hero__portrait">
          <img src={asset('/img/portrait-woven.webp')} width="640" height="640" alt="" fetchpriority="high" decoding="async" />
          <canvas class="hero__unweave" aria-hidden="true"></canvas>
        </div>
        <div class="hero__weave hero__weave--bottom"></div>
        <div class="hero__fringe"></div>
      </div>
    </div>

    <div class="hero__first">
      <div class="hero__identity">
        <p class="hero__ribbon">Full-stack developer · Analytics · QA</p>
        <p class="hero__subline">Dhaka, Bangladesh <span>·</span> Open for work</p>
        <p class="hero__statement">Fozayel Ibn Ayaz — building useful interfaces with <span>React</span>, <span>Node</span> and careful testing.</p>
      </div>
      <div class="hero__metric"><span>Live sites</span><strong>{String(liveNow).padStart(2, '0')}</strong></div>
      <h1 class="hero__title" id="hero-title" aria-label="Ayaz">
        <span class="hero__name-start" aria-hidden="true">AY</span><span class="hero__name-end" aria-hidden="true">AZ</span>
      </h1>
      <a class="hero__scroll" href="#work">Scroll <span aria-hidden="true">↓</span></a>
    </div>

    <div class="hero__intro" data-hero-intro>
      <img class="hero__map" src={asset('/img/bangladesh-weave.svg')} alt="" width="340" height="390" />
      <div class="hero__place"><span aria-hidden="true">◆</span><div>Dhaka, Bangladesh<br /><small>23°48′N 90°25′E</small></div></div>
      <p class="hero__intro-copy">Hello! I’m Ayaz, a full-stack developer working across interfaces, data and quality. I build the layers between an idea and a working product — and the tests that keep them honest.</p>
    </div>
  </div>
</section>
<script>
  import 'src/scripts/hero-scroll';
</script>
