---
import SecHead from './SecHead.astro';
import { capabilities } from 'src/data/content';

const icons: Record<string, string> = {
  build:
    '<rect x="3" y="4.5" width="18" height="15" rx="2.5"/><path d="M3 9h18" stroke-linecap="round"/><path d="M6.2 6.8h.01M8.6 6.8h.01" stroke-linecap="round"/><path d="M9.5 12.5l-2 2 2 2M14.5 12.5l2 2-2 2" stroke-linecap="round" stroke-linejoin="round"/>',
  measure:
    '<path d="M4 20V11M9.3 20V5.5M14.6 20v-6M20 20V8.5" stroke-linecap="round"/><path d="M2.5 20h19" stroke-linecap="round" opacity=".5"/>',
  care:
    '<path d="M12 20.5s-7-3.9-7-9.2A4.4 4.4 0 0112 8.4a4.4 4.4 0 017 2.9c0 5.3-7 9.2-7 9.2z" stroke-linejoin="round"/><path d="M9.4 12.6l1.9 1.9 3.4-3.6" stroke-linecap="round" stroke-linejoin="round"/>',
};
---
<section class="section caps" id="services" aria-labelledby="caps-title">
  <div class="shell">
    <SecHead num="002" label="Services" right="What I actually do" />
    <div class="caps__grid">
      {capabilities.map((cap) => (
        <article class="cap">
          <span class="cap__num mono mono--sm">{cap.k}</span>
          <span class="cap__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" set:html={icons[cap.icon]} />
          </span>
          <h2 class="cap__title" id={cap.k === '01' ? 'caps-title' : undefined}>{cap.title}</h2>
          <p class="cap__line">{cap.line}</p>
          <p class="cap__bullet mono mono--sm">{cap.bullet}</p>
        </article>
      ))}
    </div>
  </div>
</section>
