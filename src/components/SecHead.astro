---
interface Props { num: string; label: string; meta?: string }
const { num, label, meta } = Astro.props;
---
<div class="sec-head">
  <span class="sec-head__num">{num}</span>
  <span>{label}</span>
  <span class="sec-head__rule" aria-hidden="true"></span>
  {meta && <span class="sec-head__meta">{meta}</span>}
</div>
