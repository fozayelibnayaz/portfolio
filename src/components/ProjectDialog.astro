---
/* Case study sheet. Content is injected from the project payload that
   WorkList already renders — one JSON blob, no second source of truth. */
---
<div class="sheet" data-dialog aria-hidden="true" inert role="dialog" aria-modal="true" aria-labelledby="dlg-title">
  <div class="sheet__panel" role="document">
    <div class="sheet__top">
      <span class="sheet__kind" data-dlg-cat>Case study</span>
      <button class="sheet__close" type="button" data-dialog-close aria-label="Close case study">
        Close <span aria-hidden="true">✕</span>
      </button>
    </div>

    <div class="sheet__body">
      <div class="sheet__media">
        <img data-dlg-img src="" alt="" width="1200" height="675" />
      </div>

      <h2 class="sheet__title" id="dlg-title" data-dlg-title></h2>
      <p class="sheet__sub" data-dlg-sub></p>

      <div class="sheet__cols">
        <div>
          <h3 class="sheet__h">The problem</h3>
          <p class="sheet__p" data-dlg-problem></p>
          <h3 class="sheet__h">What changed</h3>
          <p class="sheet__p" data-dlg-changed></p>
          <h3 class="sheet__h">What I did</h3>
          <ul class="sheet__did" data-dlg-did></ul>
        </div>

        <div>
          <dl class="sheet__facts">
            <div><dt>Role</dt><dd data-dlg-role></dd></div>
            <div><dt>Client</dt><dd data-dlg-client></dd></div>
            <div><dt>Timeline</dt><dd data-dlg-time></dd></div>
            <div><dt>Status</dt><dd data-dlg-status></dd></div>
          </dl>

          <div class="sheet__actions">
            <a class="btn btn--ink" data-dlg-link href="#" target="_blank" rel="noopener noreferrer" hidden>
              Visit live site <i aria-hidden="true">↗</i>
            </a>
            <button class="btn" type="button" data-dialog-close>Close</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
