---
import SecHead from './SecHead.astro';
import { about, site } from 'src/data/content';
---
<section class="sec sec--line about" id="about" aria-labelledby="about-title">
  <div class="shell">
    <SecHead num="05" label="About" meta="the person in the dial" />

    <div class="about__grid">
      <div>
        <h2 class="about__title" id="about-title">
          Six roles in four years.<br /><em>One habit:</em> check it.
        </h2>
        <p class="about__lead">{about.lead}</p>
        <p class="about__bio">{about.bio}</p>
      </div>

      <div class="about__side">
        <blockquote class="about__quote">“{about.quote}”</blockquote>
        <dl class="about__facts">
          {about.facts.map((f) => (
            <div><dt>{f.k}</dt><dd>{f.v}</dd></div>
          ))}
          <div><dt>Timezone</dt><dd>{site.timezone} · {site.location}</dd></div>
          <div><dt>Languages</dt><dd>Bengali · English (IELTS 6.5)</dd></div>
        </dl>
      </div>
    </div>
  </div>
</section>
