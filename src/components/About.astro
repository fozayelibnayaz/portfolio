---
import SecHead from './SecHead.astro';
import { about, site } from 'src/data/content';
import { asset } from 'src/lib/asset';
---
<section class="section about" id="about" aria-labelledby="about-title">
  <div class="shell">
    <SecHead num="004" label="About" right="The person behind it" />
    <div class="about__grid">
      <div class="about__copy">
        <h2 class="about__title" id="about-title">CODE ON THE LEFT, <em class="em">numbers</em> ON THE RIGHT</h2>
        <p class="about__lead">{about.lead}</p>
        <p class="about__bio dim">{about.bio}</p>
        <dl class="about__facts">
          {about.facts.map((f) => (
            <div><dt class="mono mono--sm">{f.k}</dt><dd>{f.v}</dd></div>
          ))}
        </dl>
        <div class="about__quote">
          <span class="about__quote-mark" aria-hidden="true">“</span>
          <p class="display">{about.quote}</p>
        </div>
      </div>
      <figure class="about__figure">
        <img src={asset('img/portrait-mono.webp')} alt={`${site.name}, developer and analyst`} loading="lazy" decoding="async" width="760" height="874" />
        <figcaption class="mono mono--sm">{site.location} · {site.timezone}</figcaption>
      </figure>
    </div>
  </div>
</section>
