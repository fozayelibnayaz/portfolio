---
/* Progressive image: AVIF first (≈53% smaller), WebP fallback.
   Both files already exist in public/img, so there is no build cost and no
   layout shift — the width/height are passed straight through. */
interface Props {
  src: string;          // e.g. "/img/work-zenji.webp"
  alt: string;
  width: number;
  height: number;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
  sizes?: string;
}
const { src, alt, width, height, loading = 'lazy', fetchpriority, class: cls, sizes } = Astro.props;
const avif = src.replace(/\.webp$/, '.avif');
---
<picture>
  <source type="image/avif" srcset={avif} {sizes} />
  <img
    src={src}
    {alt}
    {width}
    {height}
    loading={loading}
    fetchpriority={fetchpriority}
    decoding="async"
    class={cls}
  />
</picture>
