---
import SecHead from './SecHead.astro';
import { ago, describe, groupRepos, languageCounts, tintFor, type Snapshot } from 'src/lib/repos';
import snapshot from 'src/data/repos.json';

const data = snapshot as Snapshot;
const groups = groupRepos(data.repos);
const languages = languageCounts(data.repos);
const total = data.repos.length;
const hosted = data.repos.filter((r) => r.home).length;
const top = Math.max(...languages.map((l) => l.count));

/* The one ordered run: every public repo, in the order the API handed them
   over, numbered 01→50 straight through so the number is the repo's real
   position in the set. */
const kindLabel: Record<string, string> = {
  product: 'Product',
  site: 'Site',
  experiment: 'Study',
};
const ordered = groups.flatMap((g) => g.repos.map((repo) => ({ repo, kind: g.key })));

/* Pages. Eight at a time: two rows of four on a desktop, three on a tablet,
   and a compact list on a phone. The last page holds the remainder. */
const PER_PAGE = 8;
const pages: { n: number; items: { repo: (typeof ordered)[number]['repo']; kind: string; idx: number }[] }[] = [];
ordered.forEach((entry, i) => {
  const page = Math.floor(i / PER_PAGE);
  pages[page] ??= { n: page + 1, items: [] };
  pages[page]!.items.push({ ...entry, idx: i + 1 });
});

/* A monogram for the specimen panel — honest typography, not fake data. */
const monogram = (name: string) => {
  const clean = name.replace(/[^a-zA-Z0-9]/g, '');
  return clean.slice(0, 2).toUpperCase();
};
---

<section class="sec sec--line repos" id="repos" aria-labelledby="repos-title">
  <div class="shell">
    <SecHead num="04" label="Repositories" meta={`${total} public · synced ${data.synced}`} />

    <div class="repos__head">
      <h2 class="repos__title" id="repos-title">
        Every public repo.<br /><em>Rough ones included.</em>
      </h2>
      <p class="repos__lead">
        All {total} of them — shipped, half-finished and coursework alike. Kept
        public because the mess is part of the record. {hosted} have something
        running right now.
      </p>
    </div>
  </div>

  <div class="shell">
    <div class="pager" data-pager>
      <!-- Controls sit above the deck: pages you can jump to, and arrows. -->
      <div class="pager__bar">
        <span class="pager__count" aria-hidden="true">
          <b data-page-now>01</b> / {String(pages.length).padStart(2, '0')}
        </span>

        <nav class="pager__pages" aria-label="Repository pages">
          <button class="pager__arrow" type="button" data-page-prev aria-label="Previous page of repositories">
            <span aria-hidden="true">←</span>
          </button>

          <ol class="pager__nums">
            {pages.map((p) => (
              <li>
                <button
                  class="pager__num"
                  type="button"
                  data-page-go={p.n}
                  /* The visible text is the two-digit number, so the accessible
                     name has to contain it verbatim (axe: label-content-name-
                     mismatch) — "Page 3 of 7" beside a visible "03" fails. */
                  aria-label={`Page ${String(p.n).padStart(2, '0')} of ${String(pages.length).padStart(2, '0')}`}
                  aria-current={p.n === 1 ? 'page' : undefined}
                >
                  {String(p.n).padStart(2, '0')}
                </button>
              </li>
            ))}
          </ol>

          <button class="pager__arrow" type="button" data-page-next aria-label="Next page of repositories">
            <span aria-hidden="true">→</span>
          </button>
        </nav>

        <span class="pager__hint" aria-hidden="true">drag or swipe</span>
      </div>

      <!-- The deck. Each page is a full-width slide; swipe, arrows and the
           numbered buttons all move the same scroller. -->
      <div
        class="pager__viewport"
        data-pager-viewport
        tabindex="0"
        role="group"
        aria-roledescription="carousel"
        aria-label={`All ${total} public repositories, in ${pages.length} pages`}
      >
        <div class="pager__track" data-pager-track>
          {pages.map((p) => (
            <section
              class="pager__page"
              data-page={p.n}
              aria-label={`Page ${p.n} of ${pages.length}`}
            >
              <ul class="pager__grid">
                {p.items.map(({ repo, kind, idx }) => (
                  <li class="rtile" data-repo={repo.name} data-tint={tintFor(repo.name)}>
                    <a class="rtile__link" href={repo.url} target="_blank" rel="noopener noreferrer">
                      <span class="rtile__spec" aria-hidden="true">
                        <span class="rtile__mono">{monogram(repo.name)}</span>
                      </span>

                      <span class="rtile__body">
                        <span class="rtile__head">
                          <span class="rtile__top">
                            <span class="rtile__idx" aria-hidden="true">{String(idx).padStart(2, '0')}</span>
                            <span class="rtile__kind">{kindLabel[kind] ?? 'Repo'}</span>
                          </span>
                          <span class="rtile__name">{repo.name}</span>
                        </span>

                        {describe(repo) && <span class="rtile__desc">{describe(repo)}</span>}

                        <span class="rtile__meta">
                          {repo.language && <span class="rtile__lang">{repo.language}</span>}
                          {repo.stars > 0 && <span class="rtile__star">★ {repo.stars}</span>}
                          {repo.fork && <span class="rtile__flag">fork</span>}
                          <span class="rtile__when">{ago(repo.updated)}</span>
                        </span>
                      </span>
                    </a>

                    {repo.home && (
                      <a class="rtile__live" href={repo.home} target="_blank" rel="noopener noreferrer">
                        <span class="mark mark--live" aria-hidden="true"></span>
                        Live <span aria-hidden="true">↗</span>
                        <span class="sr-only"> — {repo.name} live site</span>
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </div>

      <p class="pager__status sr-only" aria-live="polite" data-page-status>
        Page 1 of {pages.length}
      </p>
    </div>
  </div>

  <div class="shell">
    <div class="repos__bar">
      <ul class="repos__langs">
        {languages.map((l) => (
          <li class="lang" data-lang={l.language}>
            <span class="lang__dot" aria-hidden="true"></span>
            <span class="lang__name">{l.language}</span>
            <span class="lang__count">{l.count}</span>
            <span class="lang__track" aria-hidden="true">
              <span class="lang__fill" style={`--w:${(l.count / top) * 100}%`}></span>
            </span>
          </li>
        ))}
      </ul>
      <p class="repos__note">
        {groups.map((g) => `${g.repos.length} ${g.label.toLowerCase()}`).join(' · ')}
      </p>
    </div>

    <a class="repos__all" href={`https://github.com/${data.user}?tab=repositories`} target="_blank" rel="noopener noreferrer">
      <span>All repositories on GitHub</span>
      <i aria-hidden="true">↗</i>
    </a>
  </div>
</section>

<script>
  /* A native horizontal scroller with one slide per page. The numbered
     buttons, the arrows, a swipe and the keyboard all drive the same
     scrollLeft, so there is one source of truth for which page is showing. */
  const viewport = document.querySelector<HTMLElement>('[data-pager-viewport]');
  const track = document.querySelector<HTMLElement>('[data-pager-track]');
  const nowEl = document.querySelector<HTMLElement>('[data-page-now]');
  const statusEl = document.querySelector<HTMLElement>('[data-page-status]');
  const nums = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-page-go]'));

  if (viewport && track && nums.length) {
    const slides = Array.from(track.querySelectorAll<HTMLElement>('[data-page]'));
    let current = 1;

    const width = () => viewport.clientWidth || 1;

    /* Write the labels. Called the moment a page is asked for, not when the
       smooth scroll finishes: a control that lags its own click feels broken,
       and the scroll handler reconciles the two anyway. */
    const paint = (n: number) => {
      current = n;
      if (nowEl) nowEl.textContent = String(n).padStart(2, '0');
      if (statusEl) statusEl.textContent = `Page ${n} of ${slides.length}`;
      for (const b of nums) {
        if (Number(b.dataset.pageGo) === n) b.setAttribute('aria-current', 'page');
        else b.removeAttribute('aria-current');
      }
      nums.find((b) => Number(b.dataset.pageGo) === n)?.scrollIntoView({
        block: 'nearest',
        inline: 'nearest',
      });
    };

    const goTo = (n: number, smooth = true) => {
      const target = Math.min(Math.max(1, n), slides.length);
      paint(target);
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      viewport.scrollTo({
        left: (target - 1) * width(),
        behavior: smooth && !reduce ? 'smooth' : 'auto',
      });
    };

    /* Read the scroll position, then write once — interleaving the two inside a
       scroll handler is a forced reflow. */
    const sync = () => {
      const w = width();
      const max = viewport.scrollWidth - viewport.clientWidth;
      const atEnd = max > 0 && viewport.scrollLeft >= max - 2;
      const raw = atEnd ? slides.length : Math.round(viewport.scrollLeft / w) + 1;
      const next = Math.min(Math.max(raw, 1), slides.length);
      if (next !== current) paint(next);
    };

    for (const b of nums) b.addEventListener('click', () => goTo(Number(b.dataset.pageGo)));
    document.querySelector('[data-page-prev]')?.addEventListener('click', () => goTo(current - 1));
    document.querySelector('[data-page-next]')?.addEventListener('click', () => goTo(current + 1));

    viewport.addEventListener('scroll', sync, { passive: true });
    addEventListener('resize', () => goTo(current, false), { passive: true });

    viewport.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        goTo(current + 1);
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        goTo(current - 1);
      } else if (e.key === 'Home') {
        e.preventDefault();
        goTo(1);
      } else if (e.key === 'End') {
        e.preventDefault();
        goTo(slides.length);
      }
    });

    sync();
  }
</script>
