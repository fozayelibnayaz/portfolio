---
import SecHead from './SecHead.astro';
import { education, experience, languages } from 'src/data/content';
---
<section class="sec xp" id="experience" aria-labelledby="xp-title">
  <div class="shell">
    <SecHead num="06" label="History" meta="six roles, one thread" />

    <h2 class="xp__title" id="xp-title">
      Where I have<br /><em>done the work.</em>
    </h2>

    <ol class="xp__list">
      {experience.map((e, i) => (
        <li class:list={['xp__row', { 'is-now': i === 0 && e.when.includes('now') }]}>
          <span class="xp__when">{e.when}</span>
          <span class="xp__role">{e.role}</span>
          <span class="xp__org">{e.org} · {e.place}</span>
        </li>
      ))}
    </ol>

    <div class="xp__foot">
      <div class="xp__edu">
        <span class="label">Education</span>
        {education.map((e) => (
          <div class="xp__eduline">
            <span>{e.when}</span>
            <b>{e.role}</b>
            <i>{e.org}</i>
          </div>
        ))}
      </div>

      <div class="xp__langs">
        <span class="label">Languages</span>
        {languages.map((l) => (
          <div class="xp__lang">
            <b>{l.name}</b>
            <span>{l.level}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
