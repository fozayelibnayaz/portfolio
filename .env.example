# Replace with a long random secret in your deployment platform; never commit real secrets.
CMS_PASSWORD=replace-with-a-long-random-password
# Public HTTPS origin for canonical tags, Open Graph and sitemap.
NEXT_PUBLIC_SITE_URL=https://your-domain.example
# Optional: mount a durable volume here (Railway example: /data).
# When unset, the CMS uses the local project directory.
PORTFOLIO_DATA_DIR=
